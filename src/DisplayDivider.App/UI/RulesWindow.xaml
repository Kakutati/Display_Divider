<Window x:Class="DisplayDivider.App.UI.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Divider — 전체화면 규칙"
        Width="600" Height="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#606060" Margin="0,0,0,10"
                   Text="테두리 없는 전체화면(borderless) 창을 지정한 존에 가둡니다. 게임은 그래픽 설정에서 '테두리 없는 창 모드'로 실행해야 합니다. 독점 전체화면(exclusive)은 Phase 3에서 지원 예정입니다."/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="ProcessCombo" IsEditable="True"
                      VerticalContentAlignment="Center"
                      ToolTip="프로세스 이름 (예: mygame). 실행 중인 창 목록에서 고르거나 직접 입력"/>
            <Button Grid.Column="1" Content="새로고침" Click="RefreshProcesses_Click" Padding="8,4" Margin="6,0,10,0"/>
            <ComboBox Grid.Column="2" x:Name="MonitorCombo" Width="150" VerticalContentAlignment="Center"
                      SelectionChanged="MonitorCombo_SelectionChanged" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="3" x:Name="ZoneCombo" Width="70" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button Grid.Column="4" Content="추가" Click="Add_Click" Padding="14,4" FontWeight="Bold"/>
        </Grid>

        <ListBox Grid.Row="2" x:Name="RulesList" FontFamily="Consolas"/>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#3B82F6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="사용/해제" Click="Toggle_Click" Padding="10,5" Margin="0,0,8,0"/>
                <Button Content="선택 규칙 삭제" Click="Delete_Click" Padding="10,5" Margin="0,0,8,0"/>
                <Button Content="닫기" Click="CloseBtn_Click" Padding="12,5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
