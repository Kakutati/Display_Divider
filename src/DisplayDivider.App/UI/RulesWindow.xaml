<Window x:Class="DisplayDivider.App.UI.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Divider — 전체화면 규칙"
        Width="640" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 안내 -->
        <StackPanel Grid.Row="0">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="테두리 없는 전체화면(borderless) 창을 지정한 존에 가둡니다. 게임은 그래픽 설정에서 '테두리 없는 창 모드'로 실행해야 합니다. 독점 전체화면(exclusive)은 Phase 3에서 지원 예정입니다."/>
            <Border Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="#8A5A00" FontSize="12"
                           Text="⚠ 지원 안 됨: Edge/Chrome 등 Chromium 브라우저의 F11 전체화면 — 브라우저가 전체화면 중 외부 창 이동을 무시하므로 가둘 수 없습니다. 브라우저는 일반 창 상태로 존에 스냅해서 사용하세요. 일부 게임도 같은 방식으로 저항하면 지원되지 않습니다."/>
            </Border>
        </StackPanel>

        <!-- 규칙 추가 -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="규칙 추가" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="ProcessCombo" IsEditable="True"
                              ToolTip="프로세스 이름 (예: mygame). 실행 중인 창 목록에서 고르거나 직접 입력"/>
                    <Button Grid.Column="1" Content="새로고침" Click="RefreshProcesses_Click" Margin="6,0,12,0"/>
                    <ComboBox Grid.Column="2" x:Name="MonitorCombo" Width="150"
                              SelectionChanged="MonitorCombo_SelectionChanged" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3" x:Name="ZoneCombo" Width="72" Margin="0,0,12,0"/>
                    <Button Grid.Column="4" Content="추가" Click="Add_Click" Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 규칙 목록 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="RulesList" BorderThickness="0" Background="Transparent"
                     FontFamily="Consolas" FontSize="13">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- 하단 바 -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="사용/해제" Click="Toggle_Click" Margin="0,0,8,0"/>
                <Button Content="선택 규칙 삭제" Click="Delete_Click" Margin="0,0,8,0"/>
                <Button Content="닫기" Click="CloseBtn_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
