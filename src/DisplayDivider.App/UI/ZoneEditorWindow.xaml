<Window x:Class="DisplayDivider.App.UI.ZoneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Divider — 존 편집"
        Width="640" Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="모니터" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged"/>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <Button Content="2분할 (좌/우)" Tag="cols:1,1" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="3분할 (3열)" Tag="cols:1,1,1" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="2분할 (상/하)" Tag="rows:1,1" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="2 × 2" Tag="grid:2,2" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="70 : 30" Tag="cols:70,30" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
        </WrapPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="열 비율" VerticalAlignment="Center"/>
            <TextBox x:Name="ColsBox" Width="120" Margin="6,0,16,0" Text="50,50" VerticalContentAlignment="Center"/>
            <TextBlock Text="행 비율" VerticalAlignment="Center"/>
            <TextBox x:Name="RowsBox" Width="120" Margin="6,0,16,0" Text="100" VerticalContentAlignment="Center"/>
            <Button Content="미리보기 적용" Click="Custom_Click" Padding="10,5"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,12" BorderBrush="#808080" BorderThickness="1" Background="#F2F2F2">
            <Canvas x:Name="PreviewCanvas" SizeChanged="PreviewCanvas_SizeChanged" ClipToBounds="True"/>
        </Border>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#3B82F6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="분할 해제" Click="Clear_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="저장" Click="Save_Click" Padding="18,6" Margin="0,0,8,0" FontWeight="Bold"/>
                <Button Content="닫기" Click="CloseBtn_Click" Padding="12,6"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
