<Window x:Class="DisplayDivider.App.UI.ZoneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Divider — 존 편집"
        Width="680" Height="580"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="모니터" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged"/>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="템플릿:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#606060"/>
            <Button Content="2분할 (좌/우)" Tag="cols:1,1" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="3분할 (3열)" Tag="cols:1,1,1" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="2분할 (상/하)" Tag="rows:1,1" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="2 × 2" Tag="grid:2,2" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="70 : 30" Tag="cols:70,30" Click="Preset_Click" Padding="10,5" Margin="0,0,6,6"/>
        </WrapPanel>

        <WrapPanel Grid.Row="2">
            <TextBlock Text="수동 편집:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#606060"/>
            <Button Content="선택 존 좌|우 분할" Click="SplitH_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="선택 존 상/하 분할" Click="SplitV_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="선택 존 삭제" Click="Delete_Click" Padding="10,5" Margin="0,0,6,6"/>
            <Button Content="선택 존과 병합…" Click="Merge_Click" Padding="10,5" Margin="0,0,6,6"/>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,6">
                <TextBlock Text="선택 존 크기" VerticalAlignment="Center"/>
                <TextBox x:Name="ZoneWBox" Width="62" Margin="6,0,4,0" VerticalContentAlignment="Center" KeyDown="SizeBox_KeyDown"/>
                <TextBlock Text="×" VerticalAlignment="Center"/>
                <TextBox x:Name="ZoneHBox" Width="62" Margin="4,0,6,0" VerticalContentAlignment="Center" KeyDown="SizeBox_KeyDown"/>
                <ComboBox x:Name="UnitCombo" Width="58" VerticalContentAlignment="Center" SelectionChanged="UnitCombo_SelectionChanged">
                    <ComboBoxItem Content="px" IsSelected="True"/>
                    <ComboBoxItem Content="%"/>
                </ComboBox>
                <Button Content="적용" Click="SizeApply_Click" Padding="10,5" Margin="6,0,0,0"/>
            </StackPanel>
        </WrapPanel>

        <TextBlock Grid.Row="3" Margin="0,2,0,0" Foreground="#909090" FontSize="12"
                   Text="존 클릭 = 선택 · 경계선 드래그 = 잡은 구간만 조절 · Shift+드래그 = 경계선 전체 이동"/>

        <Border Grid.Row="4" Margin="0,8,0,12" BorderBrush="#808080" BorderThickness="1" Background="#F2F2F2">
            <Canvas x:Name="PreviewCanvas" Background="Transparent" ClipToBounds="True"
                    SizeChanged="PreviewCanvas_SizeChanged"
                    MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                    MouseMove="PreviewCanvas_MouseMove"
                    MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp"
                    MouseLeave="PreviewCanvas_MouseLeave"/>
        </Border>

        <DockPanel Grid.Row="5">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#3B82F6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="분할 해제" Click="Clear_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="저장" Click="Save_Click" Padding="18,6" Margin="0,0,8,0" FontWeight="Bold"/>
                <Button Content="닫기" Click="CloseBtn_Click" Padding="12,6"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
